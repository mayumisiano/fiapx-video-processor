FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/identity-api ./cmd/identity-api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 app
COPY --from=builder /out/identity-api /usr/local/bin/identity-api
USER app
ENTRYPOINT ["/usr/local/bin/identity-api"]
